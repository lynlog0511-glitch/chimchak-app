# dependencies
/node_modules

# next.js build output
/.next
/out

# 타입 검사 증분 캐시 — tsconfig의 incremental:true 때문에 npm run typecheck마다 갱신된다.
# CI가 매번 typecheck를 돌리므로, 추적하면 작업 트리가 늘 더러운 상태가 된다.
*.tsbuildinfo

# misc
.DS_Store
*.pem
npm-debug.log*

# env — 온라인 코칭 서버 키 등은 로컬 .env.local·Vercel 환경변수로만 둡니다.
# 예시 파일(.env.example)만 저장소에 남깁니다.
.env
.env.*
!.env.example

# local tooling
.claude/
__pycache__/

.vercel
