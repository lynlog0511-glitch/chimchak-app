{
  "name": "chimchak-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/stamp-sw.mjs && node scripts/split-audio-manifest.mjs",
    "build": "next build",
    "start": "next start",
    "font": "python scripts/subset-font.py",
    "audio": "python scripts/synthesize-audio.py",
    "audio:split": "node scripts/split-audio-manifest.mjs",
    "audio:verify": "node scripts/verify-audio-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "npm run typecheck && npm test && npm run audio:verify && npm run lint"
  },
  "dependencies": {
    "next": "^15.5.0",
    "pretendard": "^1.3.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  }
}
